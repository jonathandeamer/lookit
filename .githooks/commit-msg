#!/bin/sh
# commit-msg hook: enforce Conventional Commits on the subject line.
#
#   <type>(<optional-scope>)<optional !>: <description>
#
# Scope is optional (feat(tui): ... and ci: ... are both fine) but closed —
# the vocabulary lives in scripts/check-conventional-subject.sh, shared with the
# CI check on PR titles. Auto-generated merge/revert/fixup subjects are skipped.
# This is local-only: install once per clone with `make hooks` (sets
# core.hooksPath to .githooks). Bypass a single commit with
# `git commit --no-verify`.

msg_file="$1"

# The subject = first non-comment, non-blank line (git strips '#' lines later).
subject=$(grep -v '^#' "$msg_file" | sed '/^[[:space:]]*$/d' | head -n 1)

# Skip messages git generates that aren't authored subjects.
case "$subject" in
	"Merge "* | "Revert "* | "fixup! "* | "squash! "* | "amend! "*)
		exit 0
		;;
esac

# Hooks run from the top of the working tree, so this relative path resolves in
# a worktree as well as the main clone.
if ! ./scripts/check-conventional-subject.sh "$subject" "Subject"; then
	echo "  Bypass once with: git commit --no-verify" >&2
	exit 1
fi
